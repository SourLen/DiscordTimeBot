# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Bot token from https://discord.com/developers/applications -> your app -> Bot
DISCORD_TOKEN=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Comma-separated guild IDs. Slash commands sync to these instantly; leave
# empty to register globally (Discord can take up to an hour to propagate).
GUILD_IDS=

# Where the SQLite database lives.
DATABASE_PATH=data/timebot.db

# Voice channels that should never count, as comma-separated channel IDs.
EXCLUDED_CHANNEL_IDS=

# Count time spent in the server's AFK channel. The AFK channel is detected
# automatically from the server settings.
TRACK_AFK_CHANNEL=false

# Pause the clock while a member is deafened (they are connected but not
# really there).
IGNORE_DEAFENED=true

# Never record bot accounts.
IGNORE_BOTS=true

# Sessions shorter than this are discarded, so channel hopping and reconnect
# blips do not litter the database.
MIN_SESSION_SECONDS=10

# IANA timezone that defines what "today", "this week" and "this month" mean,
# and when the weekly digest is posted.
TIMEZONE=Europe/Berlin

# How often the bot re-checks who is in voice and writes its heartbeat. The
# heartbeat bounds how much time an unclean shutdown can lose.
RECONCILE_INTERVAL_SECONDS=300

# ---------------------------------------------------------------------------
# Feature: milestone roles
# ---------------------------------------------------------------------------
# "<duration>=<existing role name>", comma separated. Durations accept
# w/d/h/m/s. The roles must already exist and sit below the bot's top role.
# Example: MILESTONES=10h=Regular,100h=Veteran,500h=Voice Gremlin
MILESTONES=

# ---------------------------------------------------------------------------
# Feature: weekly digest
# ---------------------------------------------------------------------------
# Channel ID to post the weekly recap in. Leave empty to disable.
DIGEST_CHANNEL_ID=

# 0 = Monday ... 6 = Sunday, and the local hour (0-23) to post at.
DIGEST_WEEKDAY=0
DIGEST_HOUR=18
# (the hour is interpreted in TIMEZONE above)

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
